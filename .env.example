# Copiar como .env en cada servidor y completar. El archivo .env no se versiona.
# Docker Compose lo lee automáticamente al levantar los servicios.

# Cuenta de Gmail que envía comprobantes y alertas de vencimiento
EMAIL_SENDER=vordia.fontana.py@gmail.com

# Contraseña de aplicación de Gmail, los 16 caracteres SIN espacios
# Se genera en https://myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=

# Clave de firma de las sesiones (64 caracteres al azar). Al cambiarla, todos vuelven a iniciar sesión.
# Generar con: openssl rand -base64 48
JWT_KEY=

# Secreto de los links de baja de correos comerciales (otra cadena larga al azar)
BAJAS_SECRET=

# IA gratuita sin tarjeta para las secuencias de correo de HQ
# Groq: https://console.groq.com → API Keys · OpenRouter: https://openrouter.ai → Keys (no comprar créditos)
GROQ_API_KEY=
OPENROUTER_API_KEY=
