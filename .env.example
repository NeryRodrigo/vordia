# Copiar como .env en cada servidor y completar. El archivo .env no se versiona.
# Docker Compose lo lee automáticamente al levantar los servicios.

# Cuenta de Gmail que envía comprobantes y alertas de vencimiento
EMAIL_SENDER=vordia.fontana.py@gmail.com

# Contraseña de aplicación de Gmail, los 16 caracteres SIN espacios
# Se genera en https://myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=
